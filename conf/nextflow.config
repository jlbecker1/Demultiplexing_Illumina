process {

    // Specific configuration for BCLCONVERT process
    withName: 'BCLCONVERT' {
        maxRetries = 0

        cpus = 24
        memory = '128.GB'
        time = '6h'
         
        // Additional arguments can be specified via ext.args
        ext.args = '--bcl-sampleproject-subdirectories true --sample-name-column-enabled true --no-lane-splitting false --num-unknown-barcodes-reported 10 --strict-mode true'
        
        // Publish directory configuration
        publishDir = [
            path: { "${params.outdir}/bclconvert" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTQC' {
        maxRetries = 0

        cpus = 8
        memory = '16.GB'
        time = '2h'
          
        // Publish directory configuration
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MD5SUM' {
        maxRetries = 0

        cpus = 1
        memory = '8.GB'
        time = '1h'
         
        // Publish directory configuration
        publishDir = [
            path: { "${params.outdir}/md5sum" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        maxRetries = 0

        cpus = 4
        memory = '24.GB'
        time = '1h'

        stageInMode = 'copy'
         
        // Publish directory configuration
        publishDir = [
            path: { "${params.outdir}/" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
